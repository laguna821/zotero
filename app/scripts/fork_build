#!/bin/bash
set -euo pipefail

#
# Build the Achmage Edition packages for Windows, macOS, and Linux
#
# Runs on Linux or macOS. Packages are written to app/dist-achmage/:
#
#   Zotero-<version>_x64_setup.exe        Windows installer
#   Zotero-<version>_mac.zip              Zotero.app, signed ad hoc
#   Zotero-<version>_linux-x86_64.tar.xz
#
# where <version> is the Zotero version with an "-achmage.N+<commit>" suffix.
#
# Requirements: Node, zip, unzip, 7z (7-Zip 22 or later, to read the Firefox disk image), rsync,
# perl, python3, xz, curl, and Git LFS checkouts. The Windows installer needs NSIS 3 (makensis) or
# Wine, which runs the Windows version of NSIS. On Linux, macOS packages also need rcodesign
# (https://github.com/indygreg/apple-platform-rs). If Wine is available, the Windows executables
# get the Achmage Edition icon.
#

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
APP_ROOT_DIR="$(dirname "$SCRIPT_DIR")"
ROOT_DIR="$(dirname "$APP_ROOT_DIR")"
. "$APP_ROOT_DIR/config.sh"
. "$SCRIPT_DIR/utils.sh"

# Version suffix, e.g., 10.0.7-achmage.1+abcdef123
VERSION_CHANNEL="achmage"
# Update channel built into the app. Updates from zotero.org are disabled by leaving the update URL
# out of application.ini, so this only has to be a channel that the macOS ChannelPrefs patch
# accepts.
UPDATE_CHANNEL="release"

function usage {
	cat >&2 <<DONE
Usage: $0 [-p PLATFORMS] [-j]

Options
 -p PLATFORMS        platforms to build (w=Windows, m=Mac, l=Linux; default: wml)
 -j                  skip the JS build (use the existing build/ directory)
DONE
	exit 1
}

platforms="wml"
skip_js=0
while getopts "p:jh" opt; do
	case $opt in
		p)
			platforms="$OPTARG"
			;;
		j)
			skip_js=1
			;;
		*)
			usage
			;;
	esac
done

if [[ ! $platforms =~ ^[wml]+$ ]]; then
	usage
fi

cd "$ROOT_DIR"

if [ $skip_js -eq 0 ]; then
	echo "Building JS"
	NODE_OPTIONS=--openssl-legacy-provider node js-build/build.js
	echo
fi

# fetch_xulrunner gets Firefox for macOS from a disk image, which can only be mounted on macOS, but
# it uses "Firefox <version>.app.zip" instead if it exists, so on other systems create that from the
# disk image with 7-Zip
function prepare_mac_runtime {
	local xulrunner_dir="$APP_ROOT_DIR/xulrunner"
	local zip_file="$xulrunner_dir/Firefox $GECKO_VERSION_MAC.app.zip"
	if [ -e "$zip_file" ]; then
		return
	fi
	echo "Extracting Firefox $GECKO_VERSION_MAC for macOS from disk image"
	local tmp
	tmp=$(mktemp -d)
	local url="https://ftp.mozilla.org/pub/firefox/releases/$GECKO_VERSION_MAC"
	curl -fsSL -o "$tmp/Firefox.dmg" "$url/mac/en-US/Firefox%20$GECKO_VERSION_MAC.dmg"
	curl -fsSL -o "$tmp/SHA256SUMS" "$url/SHA256SUMS"
	local expected
	expected=$(grep " mac/en-US/Firefox $GECKO_VERSION_MAC.dmg$" "$tmp/SHA256SUMS" | cut -d' ' -f1)
	if [ -z "$expected" ]; then
		echo "Checksum for Firefox $GECKO_VERSION_MAC disk image not found" >&2
		exit 1
	fi
	echo "$expected  $tmp/Firefox.dmg" | sha256sum -c -
	7z x -snl -o"$tmp/dmg" "$tmp/Firefox.dmg" > /dev/null
	mkdir -p "$xulrunner_dir"
	(cd "$tmp/dmg/Firefox" && zip -qry "$zip_file" Firefox.app)
	rm -rf "$tmp"
	echo
}

# Firefox uses icons in <app>/chrome/icons/default/ for its windows
function install_window_icons {
	local app_dir=$1
	mkdir -p "$app_dir/chrome/icons/default"
	cp "$APP_ROOT_DIR/branding/window-icons/"* "$app_dir/chrome/icons/default/"
}

# Download a file and verify its SHA-256 checksum
function fetch_checked {
	local url=$1
	local file=$2
	local sha256=$3
	mkdir -p "$(dirname "$file")"
	curl -fsSL -o "$file.part" "$url"
	if ! echo "$sha256  $file.part" | sha256sum -c --status -; then
		echo "Checksum mismatch for $url" >&2
		rm "$file.part"
		exit 1
	fi
	mv "$file.part" "$file"
}

# Run a Windows program with Wine, without a display so that Wine's first-run setup doesn't open
# windows
function run_wine {
	local prefix="$APP_ROOT_DIR/xulrunner/wineprefix"
	mkdir -p "$prefix"
	env -u DISPLAY -u WAYLAND_DISPLAY \
		WINEPREFIX="$prefix" WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml=" \
		timeout 600 wine "$@"
}

# Replace the icon resource used by Explorer and shortcuts
function set_windows_exe_icon {
	local exe=$1
	local name
	name=$(basename "$exe")
	local rcedit="$APP_ROOT_DIR/xulrunner/bin/rcedit-x64.exe"
	if ! command -v wine > /dev/null; then
		echo "wine not found -- leaving the $name icon unchanged"
		return
	fi
	if [ ! -e "$rcedit" ]; then
		fetch_checked https://github.com/electron/rcedit/releases/download/v2.0.0/rcedit-x64.exe \
			"$rcedit" 3e7801db1a5edbec91b49a24a094aad776cb4515488ea5a4ca2289c400eade2a
	fi
	if run_wine "$rcedit" "$exe" --set-icon "$APP_ROOT_DIR/win/zotero.ico"; then
		echo "Set $name icon"
	else
		echo "Couldn't set the $name icon -- leaving it unchanged"
	fi
}

NSIS_VERSION=3.13

# makensis from NSIS 3 for this system, or the Windows version under Wine
function run_makensis {
	if command -v makensis > /dev/null; then
		makensis "$@"
		return
	fi
	if ! command -v wine > /dev/null; then
		echo "The Windows installer needs NSIS 3 (makensis) or Wine" >&2
		exit 1
	fi
	local nsis_dir="$APP_ROOT_DIR/xulrunner/nsis-$NSIS_VERSION"
	if [ ! -e "$nsis_dir/makensis.exe" ]; then
		local zip_file="$APP_ROOT_DIR/xulrunner/nsis-$NSIS_VERSION.zip"
		fetch_checked "https://downloads.sourceforge.net/project/nsis/NSIS%203/$NSIS_VERSION/nsis-$NSIS_VERSION.zip" \
			"$zip_file" ba63dffc4410ee89193e1cb5a41989991bd77c61068da17e3156d136b7b0b3d8
		unzip -q "$zip_file" -d "$APP_ROOT_DIR/xulrunner"
		rm "$zip_file"
	fi
	run_wine "$nsis_dir/makensis.exe" "$@"
}

# The plugins that the installer scripts use, from the same sources as win/download-nsis-plugins
function fetch_nsis_plugins {
	local dir=$1
	if [ -e "$dir/nsProcess.dll" ]; then
		return
	fi
	local url="https://hg.mozilla.org/mozilla-central/raw-file/052d53200cf8/other-licenses/nsis/Plugins"
	fetch_checked "$url/ApplicationID.dll" "$dir/ApplicationID.dll" \
		096e40b3fd5803f323660b2687946d4d6ad004e84b27ab67d4f60707358ee375
	fetch_checked "$url/ShellLink.dll" "$dir/ShellLink.dll" \
		5d103419245e2a5f124a96cace25d6836b2398edc0aa3919829b0fd6ad8b5d6a
	fetch_checked "$url/UAC.dll" "$dir/UAC.dll" \
		0d21041a1b5cd9f9968fc1d457c78a802c9c5a23f375327e833501b65bcd095d
	# A 7-Zip archive, despite the name
	fetch_checked https://download.zotero.org/dev/win/NsProcess-1.6.zip "$dir/NsProcess.zip" \
		fc19fc66a5219a233570fafd5daeb0c9b85387b379f6df5ac8898159a57c5944
	7z e -y -o"$dir" "$dir/NsProcess.zip" Plugin/nsProcessW.dll > /dev/null
	rm "$dir/NsProcess.zip"
	mv "$dir/nsProcessW.dll" "$dir/nsProcess.dll"
}

# Build the installer as build.sh does on Windows: a 7-Zip self-extractor that runs the NSIS
# setup.exe on the app, which includes the uninstaller
function build_windows_installer {
	local app_dir=$1
	local installer=$2
	local dir="$work_dir/win_installer"
	rm -rf "$dir"
	cp -r "$APP_ROOT_DIR/win/installer" "$dir"
	perl -pi -e "s/\{\{VERSION}}/$version/" "$dir/defines.nsi"
	cp "$APP_ROOT_DIR/win/zotero.ico" "$dir/setup.ico"
	fetch_nsis_plugins "$APP_ROOT_DIR/xulrunner/nsis-plugins"
	cp "$APP_ROOT_DIR/xulrunner/nsis-plugins/"*.dll "$dir"

	# The scripts were written for the Unicode version of NSIS 2, so make NSIS 3 build Unicode
	# installers. They're passed as relative paths, since makensis.exe would take an absolute
	# path from Linux or macOS for an option.
	(cd "$dir" && run_makensis "-XUnicode true" -DHAVE_64BIT_BUILD -V1 uninstaller.nsi)
	mkdir -p "$app_dir/uninstall"
	mv "$dir/helper.exe" "$app_dir/uninstall/"
	(cd "$dir" && run_makensis "-XUnicode true" -DHAVE_64BIT_BUILD -V1 installer.nsi)

	mkdir "$dir/staging"
	cp -r "$app_dir" "$dir/staging/core"
	mv "$dir/setup.exe" "$dir/staging/"
	(cd "$dir/staging" && 7z a -r -t7z "$dir/app.7z" \
		-mx -m0=BCJ2 -m1=LZMA:d24 -m2=LZMA:d19 -m3=LZMA:d19 -mb0:1 -mb0s1:2 -mb0s2:3 > /dev/null)
	local sfx="$dir/7zstub/firefox/7zSD.sfx"
	set_windows_exe_icon "$sfx"
	cat "$sfx" "$dir/app.tag" "$dir/app.7z" > "$installer"
	chmod 755 "$installer"
}

function sign_mac_app {
	local app=$1
	echo "Signing $app ad hoc"
	if [[ "$(uname)" = "Darwin" ]]; then
		xattr -cr "$app"
		/usr/bin/codesign --force --deep --sign - "$app"
	else
		# rcodesign keeps the hardened runtime of Mozilla's helper apps, under which ad hoc signed
		# libraries fail library validation, so sign unsigned files as codesign --force would
		python3 "$SCRIPT_DIR/macho_remove_signatures" "$app"
		rcodesign sign "$app"
	fi
}

# build.sh recreates its dist directory on every run, so collect packages separately
OUT_DIR="$APP_ROOT_DIR/dist-achmage"

hash=$(git -C "$ROOT_DIR" rev-parse --short HEAD)
build_dir=$(mktemp -d)
work_dir=$(mktemp -d)
trap 'rm -rf "$build_dir" "$work_dir"' EXIT

"$SCRIPT_DIR/prepare_build" -s "$ROOT_DIR/build" -o "$build_dir" -c "$VERSION_CHANNEL" -m "$hash"
version=$(cat "$build_dir/version")
mkdir -p "$OUT_DIR"

# build.sh clears the staging directory each time, so package each platform right after staging it
for (( i=0; i<${#platforms}; i++ )); do
	case ${platforms:i:1} in
		w)
			"$APP_ROOT_DIR/build.sh" -d "$build_dir" -p w -a x64 -c "$UPDATE_CHANNEL" -s
			stage="$STAGE_DIR/Zotero_win-x64"
			install_window_icons "$stage/app"
			set_windows_exe_icon "$stage/zotero.exe"
			package="$OUT_DIR/Zotero-${version}_x64_setup.exe"
			build_windows_installer "$stage" "$package"
			;;

		m)
			if [[ "$(uname)" != "Darwin" ]]; then
				prepare_mac_runtime
			fi
			"$APP_ROOT_DIR/build.sh" -d "$build_dir" -p m -c "$UPDATE_CHANNEL" -s
			sign_mac_app "$STAGE_DIR/Zotero.app"
			package="$OUT_DIR/Zotero-${version}_mac.zip"
			rm -f "$package"
			(cd "$STAGE_DIR" && zip -rqyX "$package" Zotero.app)
			;;

		l)
			"$APP_ROOT_DIR/build.sh" -d "$build_dir" -p l -a x64 -c "$UPDATE_CHANNEL" -s
			stage="$STAGE_DIR/Zotero_linux-x86_64"
			install_window_icons "$stage/app"
			package="$OUT_DIR/Zotero-${version}_linux-x86_64.tar.xz"
			rm -f "$package"
			tar -C "$STAGE_DIR" -cJf "$package" Zotero_linux-x86_64
			;;
	esac
	echo "Created $package"
	echo
done

(cd "$OUT_DIR" && sha256sum Zotero-"${version}"_* > "SHA256SUMS-${version}")
echo "Done: $OUT_DIR"
